{
  "manifest_version": 3,
  "name": "Max Subtitles - Subtitles for HBO Max",
  "version": "1.0.0",
  "description": "Tự động hiển thị phụ đề tiếng Việt chuẩn xác trên HBO Max và Max.com, thay thế phụ đề tiếng Anh gốc.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.max.com/*",
    "*://*.hbomax.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hbomax.com/*",
        "*://*.max.com/*"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.hbomax.com/*",
        "*://*.max.com/*"
      ],
      "js": [
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Max Subtitles Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/*.js",
        "src/content/overlay.css"
      ],
      "matches": [
        "*://*.max.com/*",
        "*://*.hbomax.com/*"
      ]
    }
  ]
}
